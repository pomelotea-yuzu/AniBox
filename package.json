{
  "name": "anibox-workspace",
  "version": "1.2.3",
  "private": true,
  "description": "AniBox 工作区根：仓库治理、门禁与桌面端委托入口。应用本体在 apps/desktop。",
  "license": "MIT",
  "scripts": {
    "dev": "npm --prefix apps/desktop run dev",
    "build": "npm --prefix apps/desktop run build",
    "preview": "npm --prefix apps/desktop run preview",
    "package": "npm --prefix apps/desktop run package",
    "typecheck": "npm --prefix apps/desktop run typecheck",
    "lint": "npm --prefix apps/desktop run lint",
    "test": "npm --prefix apps/desktop run test",
    "check:gates": "node scripts/check-repo.mjs --all",
    "check": "npm run check:gates && npm --prefix apps/desktop run check"
  }
}
